    {
      "parameters": {
        "jsCode": "const data = $('Make Summary data').first().json;\n\nreturn [\n  {\n    json: {\n      \"Date\": new Date().toISOString().split('T')[0],\n      \"Total Jobs\": data.totalJobs,\n      \"Top Hiring Companies\": data.companies\n        .map(c => `${c[0]} (${c[1]})`)\n        .join(\", \"),\n      \"Top Locations\": data.locations\n        .map(l => `${l[0]} (${l[1]})`)\n        .join(\", \"),\n      \"AI Summary\": $json.output || $json.text || \"\"\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
